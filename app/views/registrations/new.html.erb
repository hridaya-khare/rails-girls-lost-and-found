<% content_for :title, "Sign up" %>

<div class="auth">
  <div class="auth__card">
    <div class="auth__icon">👋</div>
    <h1>Join Campus Lost &amp; Found</h1>
    <p class="muted">It takes 30 seconds. Then help someone get their things back.</p>

    <%= form_with model: @user, url: registration_path, class: "form" do |form| %>
      <% if @user.errors.any? %>
        <div class="form-errors" role="alert">
          <ul>
            <% @user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :name, "Your name", class: "field__label" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", placeholder: "Priya Sharma", class: "input" %>
      </div>
      <div class="field">
        <%= form.label :email_address, "Email", class: "field__label" %>
        <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@college.edu", class: "input" %>
      </div>
      <div class="field-row">
        <div class="field">
          <%= form.label :password, class: "field__label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
        </div>
        <div class="field">
          <%= form.label :password_confirmation, "Confirm", class: "field__label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
        </div>
      </div>
      <%= form.submit "Create account", class: "btn btn--primary btn--block" %>
    <% end %>

    <p class="auth__switch">Already have an account? <%= link_to "Sign in", new_session_path %></p>
  </div>
</div>
